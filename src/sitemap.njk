---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for path in site.staticPages %}
  <url><loc>{{ site.url }}{{ path }}</loc></url>
{%- endfor %}
{%- for page in collections.sitemap %}
  <url><loc>{{ site.url }}{{ page.url }}</loc>{% if page.data.updatedAt %}<lastmod>{{ page.data.updatedAt }}</lastmod>{% endif %}</url>
{%- endfor %}
</urlset>
