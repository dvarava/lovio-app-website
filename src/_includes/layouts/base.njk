<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    {%- if draft %}
    <meta name="robots" content="noindex">
    {%- else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {%- endif %}
    <meta name="theme-color" content="#FBF6F3">
    <meta property="og:type" content="{{ 'article' if type == 'article' else 'website' }}">
    <meta property="og:site_name" content="Lovio">
    <meta property="og:title" content="{{ ogTitle or title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}/assets/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css?v={{ site.assetVersion }}">
    <link rel="stylesheet" href="/content.css?v={{ site.assetVersion }}">
    <script type="application/ld+json">{{ jsonLd | safe }}</script>
</head>

<body>
    <div class="site-header wrap">
        <header class="nav" data-open="false">
            <a href="/" class="brand" aria-label="Lovio home"><img src="/assets/logo.png" alt=""><span>lovio</span></a>
            <nav class="nav-links" id="site-menu" aria-label="Main">
                {%- for item in site.nav %}
                <a href="{{ item.url }}"{% if page.url == item.url or (item.section and section == item.section) %} aria-current="page"{% endif %}>{{ item.label }}</a>
                {%- endfor %}
            </nav>
            <div class="nav-actions">
                <a href="/download/" class="nav-cta">Download</a>
                <button type="button" class="nav-toggle" aria-controls="site-menu" aria-expanded="false" aria-label="Open menu"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg></button>
            </div>
        </header>
    </div>

    <main class="wrap c-main">
        {%- if breadcrumbs is defined %}
        <nav class="c-crumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Home</a></li>
                {%- for crumb in breadcrumbs %}
                <li><a href="{{ crumb.url }}">{{ crumb.label }}</a></li>
                {%- endfor %}
                <li aria-current="page">{{ crumbLabel or h1 }}</li>
            </ol>
        </nav>
        {%- endif %}
        {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}

    <script src="/site.js?v={{ site.assetVersion }}"></script>
</body>

</html>
